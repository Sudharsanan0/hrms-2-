# ============================================================
# Clixhora HRMS — Supabase configuration
#
# Copy this file to `.env` (development) or `.env.local` and fill in the
# values from: https://supabase.com/dashboard → Your Project → Project Settings → API
#
#   cp .env.example .env
#
# Only the PUBLIC key belongs here. Every VITE_* variable is compiled into
# the browser bundle, so NEVER put a service-role / secret key in this file.
# ============================================================

# Project URL — "https://<project-ref>.supabase.co"
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Public key — use ONE of the two lines below.
#   1. New projects:  "publishable" key (sb_publishable_...)
#   2. Legacy projects: "anon" key (eyJ...)
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
# VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Optional — shown on the setup banner when something is wrong.
# VITE_HRMS_SETUP_HINT=Ask your Supabase administrator for the public key.
